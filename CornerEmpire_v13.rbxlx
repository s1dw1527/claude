	wp(m, o, "seat", -hw + 3.5, hd - 8) wp(m, o, "seat", -hw + 5, hd - 2) wp(m, o, "seat", hw - 7.4, hd - 4) wp(m, o, "seat", hw - 2.6, hd - 4)
	wp(m, o, "trash", hw - 3, hd - 8) wp(m, o, "staffroom", hw - 4, -hd + 3)
